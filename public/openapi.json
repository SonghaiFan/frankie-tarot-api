{
  "openapi": "3.1.0",
  "info": {
    "title": "Franklin Tarot API",
    "version": "1.0.0",
    "description": "Read-only bilingual tarot catalog and spread definitions. Optional delegated draws respect per-position pools. Frankie owns manual selection and orientation. Only draw when the user explicitly delegates automatic drawing. A reading topic alone is not permission to replace manual selection. Use actual returned results; never fabricate cards after a failed or unexecuted call. Prefer imageUrls.redraw for artwork. Every request samples again: reuse saved results to repeat a reading. Opening Frankie or choosing a spread does not authorize drawing or interpretation. Interpret only after an explicit user request. No public seed, idempotency key or recovery endpoint exists. Retain successful results and orientations; after an uncertain failure require an explicit retry decision, since another call is a new draw and may coincidentally match. The caller owns orientation and interpretation; tarot is symbolic reflection, not factual prediction."
  },
  "servers": [
    {
      "url": "https://tarot-api.songhai.site",
      "description": "Public Franklin Tarot API"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "service": "franklin-tarot-api",
                  "apiVersion": "1"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cards": {
      "get": {
        "operationId": "searchTarotCards",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "arcana",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "MAJOR",
                "MINOR"
              ]
            }
          },
          {
            "name": "suit",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "WANDS",
                "CUPS",
                "SWORDS",
                "PENTACLES"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "zh-CN"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every matching card; no pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardsResponse"
                },
                "example": {
                  "cards": [
                    {
                      "id": "maj00",
                      "name": "The Fool",
                      "names": {
                        "en": "The Fool",
                        "zh-CN": "愚人"
                      },
                      "arcana": "MAJOR",
                      "suit": null,
                      "rank": 0,
                      "imageUrls": {
                        "redraw": "https://tarot-api.songhai.site/images/cards/maj00.webp?v=350d0b7d530942dd",
                        "dreamy": "https://tarot-api.songhai.site/images/cards_dreamy/maj00.webp?v=350d0b7d530942dd",
                        "original": "https://tarot-api.songhai.site/images/cards_rws_original/maj00.webp?v=350d0b7d530942dd"
                      },
                      "keywords": {
                        "en": [
                          "Infinite potential",
                          "New beginnings",
                          "Childlike heart",
                          "Innocence",
                          "Freedom",
                          "Adventure"
                        ],
                        "zh-CN": [
                          "无限潜力",
                          "新的开始",
                          "赤子之心",
                          "纯真",
                          "自由",
                          "冒险"
                        ]
                      },
                      "description": {
                        "en": "The Fool, Mate, or Unwise Man. Court de Gebelin places it at the head of the whole series as the zero or negative which is presupposed by numeration. The Fool carries a wallet; he is looking over his shoulder and does not know that he is on the brink of a precipice ; but a dog or other animal is attacking him from behind. He signifies the journey outward, the state of the first emanation, the graces and passivity of the spirit.",
                        "zh-CN": "他是追寻经验的灵魂,一位身着华服的流浪者 。他背对过去,无忧无虑地停驻在悬崖边缘,凝视着远方未知的虚空 。他手中的白玫瑰象征着尚未被欲望沾染的纯洁,肩上的行囊则装满了未经开发的无限潜能 。他是另一世界的王子,象征着向外旅程、第一次发出的状态,以及精神的优雅与被动 。"
                      },
                      "meanings": {
                        "upright": {
                          "en": "Starting from zero; luck in gambling; unconventionality; pursuit of novel dreams; adventure; uninhibited living; an artist's temperament; out of the ordinary; striking directly at the key point or blind spot; a hunter in love; transcendent spiritual love; free love unconstrained by form",
                          "zh-CN": "从零开始; 好赌运; 不墨守成规; 追求新奇的梦想; 冒险; 放浪形骸; 艺术家的气质; 异于常人; 直攻要害、盲点; 爱情狩猎者; 精神上的超然之爱; 不拘形式的自由恋爱"
                        },
                        "reversed": {
                          "en": "Instability; reckless gambles ending in failure; lack of responsibility; loss; unsteady footing; degeneration; taking the wrong path; eccentric behavior; frivolous romance; hot-and-cold feelings; an unstable journey in love; negligence; emptiness; vanity",
                          "zh-CN": "不安定; 孤注一掷会失败; 缺乏责任感; 损失; 脚跟站不稳; 堕落; 走错路; 行为乖张; 轻浮的恋情; 感情忽冷忽热; 不安定的爱情之旅; 疏忽; 虚无; 虚荣 "
                        }
                      },
                      "source": {
                        "dataset": "frankie-tarot-ground-truth",
                        "datasetVersion": "350d0b7d530942dd",
                        "note": "Project-curated data. Per-field source attribution has not been independently verified."
                      }
                    }
                  ],
                  "locale": "en"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
