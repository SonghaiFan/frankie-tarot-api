    "/api/v1/spreads": {
      "get": {
        "operationId": "listTarotSpreads",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "zh-CN"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "11 drawable spreads; positions are null for flex layouts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpreadsResponse"
                },
                "example": {
                  "spreads": [
                    {
                      "id": "SINGLE",
                      "name": "One Card Draw",
                      "names": {
                        "en": "One Card Draw",
                        "zh-CN": "单张指引"
                      },
                      "description": "A simple and direct one-card reading. Instead of asking a strict yes-or-no question, try asking what you need to notice, shift, or understand right now.",
                      "descriptions": {
                        "en": "A simple and direct one-card reading. Instead of asking a strict yes-or-no question, try asking what you need to notice, shift, or understand right now.",
                        "zh-CN": "这个牌阵是最简单直接的指引,只用到一张塔罗牌。\n建议避免单纯的\"是/否\"提问,而是用\"我需要注意什么...\"来获得更深层的当下指引。"
                      },
                      "cardCount": 1,
                      "labels": [
                        "Insight"
                      ],
                      "labelsByLocale": {
                        "en": [
                          "Insight"
                        ],
                        "zh-CN": [
                          "核心启示"
                        ]
                      },
                      "cardPools": [
                        "FULL"
                      ],
                      "layout": {
                        "type": "flex",
                        "positions": null
                      },
                      "interpretationInstruction": "\nThe One Card Draw\" .\n- Card 1: The Insight regarding the specific topic.\nSynthesis Goal: Do NOT answer with a simple 'Yes' or 'No'. Focus on the 'appropriateness' of the card drawn . Interpret the card as the specific attitude, perspective, or circumstance the seeker needs to be aware of right now to make the day or situation more rewarding .\n    ",
                      "interpretationInstructions": {
                        "en": "\nThe One Card Draw\" .\n- Card 1: The Insight regarding the specific topic.\nSynthesis Goal: Do NOT answer with a simple 'Yes' or 'No'. Focus on the 'appropriateness' of the card drawn . Interpret the card as the specific attitude, perspective, or circumstance the seeker needs to be aware of right now to make the day or situation more rewarding .\n    ",
                        "zh-CN": "\n单张牌阵。\n- 牌 1:当下最重要的核心提示。\n综合目标:不要给简单的是/否结论。请解释这张牌所指向的关键态度、注意事项或行动方向,并与求问者问题直接关联。\n    "
                      },
                      "defaultQuestions": {
                        "en": [
                          "What do I need to pay attention to here?",
                          "What attitude would serve me best today?",
                          "What insight is this situation offering me?"
                        ],
                        "zh-CN": [
                          "关于这件事,我需要留意什么?",
                          "今天采取什么样的态度最有用?",
                          "这个问题能带给我什么启示?"
                        ]
                      }
                    }
                  ],
                  "locale": "en"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/spreads/{spreadId}/draw": {
      "get": {
        "operationId": "drawTarotSpread",
        "description": "One unique card per one-based position, respecting its card pool. Only draw when the user explicitly delegates automatic drawing. A reading topic alone is not permission to replace manual selection. Use actual returned results; never fabricate cards after a failed or unexecuted call. Prefer imageUrls.redraw for artwork. Every request samples again: reuse saved results to repeat a reading. Opening Frankie or choosing a spread does not authorize drawing or interpretation. Interpret only after an explicit user request. No public seed, idempotency key or recovery endpoint exists. Retain successful results and orientations; after an uncertain failure require an explicit retry decision, since another call is a new draw and may coincidentally match. The caller owns orientation and interpretation; tarot is symbolic reflection, not factual prediction.",
        "parameters": [
          {
            "name": "spreadId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "SINGLE",
                "THREE",
                "COURT",
                "FOUR",
                "FIVE",
                "TIMELINE",
                "DIMENSION",
                "CELTIC",
                "RELATION",
                "GOALS",
                "YEARLY"
              ],
              "examples": [
                "THREE"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "zh-CN"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actual spread draw without orientation; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrawResponse"
                },
