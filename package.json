{
  "name": "franklin-tarot-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "api": "node --import tsx scripts/api-server.ts",
    "api:bundle": "node scripts/api-build.mjs",
    "api:test": "node --import tsx --test tests/*.test.ts",
    "mcp:agent": "node --import tsx mcp/agent-main.ts",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "node --import tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.554.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.25.12",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
